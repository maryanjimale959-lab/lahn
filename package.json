{
  "name": "lahn",
  "private": true,
  "version": "0.1.0",
  "description": "Lahn — your own music library. Paste a link, keep the song. Created by Maryam J.",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run build --workspace web && npm start --workspace server",
    "doctor": "node server/src/doctor.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright-core": "^1.63.0"
  }
}
